# CORTEX Configuration
# Copy this file to .env and fill in your API keys

# === Required for Market Data ===
CORTEX_POLYGON_API_KEY=your_polygon_api_key_here

# === Required for AI Chat ===
CORTEX_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === Optional: Interactive Brokers ===
# TWS or IB Gateway must be running locally
CORTEX_IBKR_HOST=127.0.0.1
CORTEX_IBKR_PORT=4002          # 4002=paper trading, 4001=live
CORTEX_IBKR_CLIENT_ID=1

# === Optional: Coinbase ===
CORTEX_COINBASE_API_KEY=
CORTEX_COINBASE_PRIVATE_KEY=

# === Optional: News & Flow Data ===
CORTEX_UNUSUAL_WHALES_API_KEY=
CORTEX_BENZINGA_API_KEY=

# === Server Settings ===
CORTEX_HOST=127.0.0.1
CORTEX_WS_PORT=8765

# === AI Model ===
CORTEX_CLAUDE_MODEL=claude-opus-4-6

# === Risk Limits ===
CORTEX_MAX_POSITION_PCT=5.0
CORTEX_MAX_DAILY_LOSS=1000.0
CORTEX_MAX_DRAWDOWN_PCT=7.0
